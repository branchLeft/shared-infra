{{- $pages := slice -}}
{{- range .Site.RegularPages -}}
{{- $pages = $pages | append (dict "title" .Title "path" (strings.TrimPrefix "/" .RelPermalink) "text" (.Plain | htmlUnescape)) -}}
{{- end -}}
{{- $pages = $pages | append (dict "title" .Title "path" "" "text" (.Plain | htmlUnescape)) -}}
{{- $pages | jsonify -}}
