# @branchleft/* packages are hosted on GitHub Packages, not npmjs. Only the
# scope is redirected: everything else still resolves from the default
# registry.
#
# GitHub Packages' npm registry rejects anonymous requests even for public
# packages, so a token is always needed. Locally that is a Personal Access
# Token with `read:packages` in your user-level ~/.npmrc:
#
#   //npm.pkg.github.com/:_authToken=YOUR_GITHUB_PAT
#
# In CI it is the run's own GITHUB_TOKEN, passed as NODE_AUTH_TOKEN by the
# workflow. No token is committed here.
@branchleft:registry=https://npm.pkg.github.com
