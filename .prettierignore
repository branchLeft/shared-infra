# Repo-specific ignores. The shared set lives in
# node_modules/@branchleft/prettier-config/prettierignore and is passed as a
# second --ignore-path; this file is named explicitly in the format scripts
# because passing any --ignore-path replaces Prettier's default rather than
# adding to it.

# Written by `pulumi config set`, not by hand. Prettier leaves these alone
# today, but the tool rewrites them wholesale on every config change and a
# formatter fighting it would produce diff churn in a file that carries KMS
# ciphertext.
Pulumi.*.yaml

# Generated by hetzner/monitoring/render.ts, not by hand. render.test.ts
# asserts these files equal the renderer's output byte-for-byte; Prettier's
# YAML quote-style rewrite (double to single) disagrees with the renderer, so
# the two fight over the same bytes every time either one runs.
hetzner/monitoring/stack/prometheus/prometheus.yml
hetzner/monitoring/stack/prometheus/alerts.yml
hetzner/monitoring/stack/alertmanager/alertmanager.yml.tmpl

# Generated by hetzner/edge/render.ts, not by hand, for the same reason as
# the monitoring config above.
hetzner/edge/stack/Caddyfile
hetzner/edge/stack/crowdsec/acquis.d/appsec.yaml
hetzner/edge/stack/crowdsec/acquis.d/caddy.yaml
hetzner/edge/validation/Caddyfile.enforcing
hetzner/edge/validation/Caddyfile.authoring
