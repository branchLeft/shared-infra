/node_modules/
/bin/
/mail/node_modules/
/mail/bin/
/hetzner/node_modules/
/hetzner/bin/
# Written by `vitest run --coverage`, which nothing in CI commits.
/hetzner/coverage/
/hetzner-host/node_modules/
/hetzner-host/dist/

# Pulumi state artifacts. Nothing under here is ever committed: this stack's
# state lives in the bucket, and a local copy of it is both a source-of-truth
# conflict and, since a checkpoint carries decrypted-at-rest resource outputs,
# a disclosure this repository must not make.
Pulumi.*.yaml.bak
/*.checkpoint.json
/stack-backup-*.json
/.pulumi/

.DS_Store
.env
__pycache__/

# Unguarded intermediates from CLOUD-ARMOR-BASELINE.md's reproduction steps
# -- a raw `gcloud` read, before the normalizer's redaction guard has run.
# The documented steps write these to a scratch directory outside the repo;
# this is the second layer, in case a future capture writes them here
# instead.
/cloud-armor-baseline/*.raw.json
/cloud-armor-baseline/*.list.json

# Rendered on the host (and in CI's throwaway checkout) by
# hetzner/monitoring/stack/render_alertmanager_config.py from
# /etc/branchleft/monitoring.env. Both carry a secret in plaintext; neither is
# ever committed. The committed inputs are alertmanager.yml.tmpl and
# prometheus.yml, which carry placeholders and a file path respectively.
/hetzner/monitoring/stack/alertmanager/alertmanager.yml
/hetzner/monitoring/stack/prometheus/mx1-metrics-password
