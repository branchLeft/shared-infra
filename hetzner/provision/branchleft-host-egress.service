# Reasserts a private-only host's default route and resolver at every boot.
# Neither survives a reboot on its own: the route is kernel state nothing
# persists, and re-running the reconciler is the mechanism, not a fallback.
[Unit]
Description=branchLeft private host egress (route + resolver)
# After, not Requires: the reconciler no-ops immediately on a host with a
# public interface, and such a host must still boot cleanly if
# network-online.target is ever slow to report -- this unit is never on the
# critical path for a host that does not need it.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/branchleft-host-egress
# A failed run (no subnet route yet, after the script's own bounded wait) is
# retried after a delay rather than left until the next timer tick. Restart=
# on a oneshot needs systemd 244 or later; Debian 11 ships 247, Debian 12 252.
Restart=on-failure
RestartSec=15s

[Install]
WantedBy=multi-user.target
