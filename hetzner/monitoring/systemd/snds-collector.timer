# Installed at /etc/systemd/system/snds-collector.timer alongside
# snds-collector.service -- see that file's header for why this pair is not
# handled by install-systemd-drop-ins.sh.
[Unit]
Description=Run the SNDS reputation collector on a schedule

[Timer]
OnBootSec=10min
# SNDS itself refreshes at most once a day, at a time Microsoft does not
# document -- 6h gives several chances to catch a fresh day's data soon after
# it publishes. The credential no longer constrains this interval: the
# automated-access URL lives 30 days, so unlike the ~8h bearer token it
# replaced, a 6h cadence is not fighting a
# credential that expires between runs. Persistent=true covers a missed run
# across a host reboot; SNDSCollectorFailing (render.ts) catches a run that
# ran and failed, and SNDSCollectorStale backstops a timer that is not
# running at all.
OnUnitActiveSec=6h
Persistent=true

[Install]
WantedBy=timers.target
