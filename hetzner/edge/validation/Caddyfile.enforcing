# Generated from sites.ts and hetzner/edge/posture.ts.
# Regenerate with `npm run render` in hetzner/. Hand edits are overwritten.
{
	email {env.ACME_EMAIL}
	acme_ca https://acme-v02.api.letsencrypt.org/directory
	servers {
		protocols h1 h2
		metrics
	}
	crowdsec {
		api_url http://crowdsec:8080
		api_key {env.CROWDSEC_BOUNCER_KEY}
		ticker_interval 15s
		appsec_url http://crowdsec:7422
		appsec_max_body_bytes 65536
		appsec_timeout 1s
		appsec_fail_open
	}
}

branchleft.co.uk {
	log {
		output file /var/log/caddy/access.log
		format json
	}
	tls {
		protocols tls1.2 tls1.3
	}
	@members_magic_link {
		method POST
		path /members/api/send-magic-link /members/api/send-magic-link/
	}
	route {
		rate_limit {
			zone website_per_ip {
				key {http.request.remote.host}
				window 60s
				events 200
			}
		}
		rate_limit @members_magic_link {
			zone members_magic_link_per_ip {
				key {http.request.remote.host}
				window 60s
				events 5
			}
		}
		crowdsec
		appsec
		reverse_proxy 10.20.1.100:8080
	}
}

www.branchleft.co.uk {
	log {
		output file /var/log/caddy/access.log
		format json
	}
	tls {
		protocols tls1.2 tls1.3
	}
	route {
		rate_limit {
			zone website_redirect_per_ip {
				key {http.request.remote.host}
				window 60s
				events 200
			}
		}
		crowdsec
		redir https://branchleft.co.uk{uri} permanent
	}
}

http://edge-probe.invalid:8080 {
	log {
		output file /var/log/caddy/probe.log
		format json
	}
	@members_magic_link {
		method POST
		path /members/api/send-magic-link /members/api/send-magic-link/
	}
	route {
		rate_limit {
			zone probe_host_per_ip {
				key {http.request.remote.host}
				window 60s
				events 200
			}
		}
		rate_limit @members_magic_link {
			zone members_magic_link_per_ip {
				key {http.request.remote.host}
				window 60s
				events 5
			}
		}
		crowdsec
		appsec
		respond 204
	}
}

:8080 {
	log {
		output file /var/log/caddy/probe.log
		format json
	}
	@members_magic_link {
		method POST
		path /members/api/send-magic-link /members/api/send-magic-link/
	}
	route {
		rate_limit {
			zone probe_per_ip {
				key {http.request.remote.host}
				window 60s
				events 200
			}
		}
		rate_limit @members_magic_link {
			zone members_magic_link_per_ip {
				key {http.request.remote.host}
				window 60s
				events 5
			}
		}
		crowdsec
		appsec
		respond 204
	}
}

:9091 {
	metrics
}
