# Generated from sites.ts and hetzner/edge/posture.ts.
# Regenerate with `npm run render` in hetzner/. Hand edits are overwritten.
{
	email {env.ACME_EMAIL}
	acme_ca https://acme-v02.api.letsencrypt.org/directory
	servers {
		protocols h1 h2
		metrics
	}
	crowdsec {
		api_url http://crowdsec:8080
		api_key {env.CROWDSEC_BOUNCER_KEY}
		ticker_interval 15s
		appsec_url http://crowdsec:7422
		appsec_max_body_bytes 65536
		appsec_timeout 1s
		appsec_fail_open
	}
}

branchleft.co.uk {
	log {
		output file /var/log/caddy/access.log {
			roll_size 100MiB
			roll_keep 31
			roll_keep_for 720h
			roll_at 00:00
		}
		format filter {
			wrap json
			request>uri regexp "(?i)([?&](?:b|%62)(?:l|%6[Cc])(?:_|%5[Ff])(?:b|%62)(?:r|%72)(?:e|%65)(?:a|%61)(?:k|%6[Bb])(?:_|%5[Ff])(?:g|%67)(?:l|%6[Cc])(?:a|%61)(?:s|%73)(?:s|%73))[^&#]*" "$1=REDACTED"
			request>headers>Referer regexp "(?i)([?&](?:b|%62)(?:l|%6[Cc])(?:_|%5[Ff])(?:b|%62)(?:r|%72)(?:e|%65)(?:a|%61)(?:k|%6[Bb])(?:_|%5[Ff])(?:g|%67)(?:l|%6[Cc])(?:a|%61)(?:s|%73)(?:s|%73))[^&#]*" "$1=REDACTED"
			resp_headers>Location regexp "(?i)([?&](?:b|%62)(?:l|%6[Cc])(?:_|%5[Ff])(?:b|%62)(?:r|%72)(?:e|%65)(?:a|%61)(?:k|%6[Bb])(?:_|%5[Ff])(?:g|%67)(?:l|%6[Cc])(?:a|%61)(?:s|%73)(?:s|%73))[^&#]*" "$1=REDACTED"
		}
	}
	tls {
		protocols tls1.2 tls1.3
	}
	@members_magic_link {
		method POST
		path /members/api/send-magic-link /members/api/send-magic-link/
	}
	@ghost_setup {
		method POST PUT
		path /ghost/api/admin/authentication/setup /ghost/api/admin/authentication/setup/* /ghost/api/*/admin/authentication/setup /ghost/api/*/admin/authentication/setup/*
	}
	@break_glass_strip expression `{http.request.orig_uri}.matches('^[^?]*[?](?:[^&]*&)*(?:b|%62)(?:l|%6[Cc])(?:_|%5[Ff])(?:b|%62)(?:r|%72)(?:e|%65)(?:a|%61)(?:k|%6[Bb])(?:_|%5[Ff])(?:g|%67)(?:l|%6[Cc])(?:a|%61)(?:s|%73)(?:s|%73)(?:=|&|$)') && (!{http.request.orig_uri}.matches('^/ghost(?:[/?]|$)') || {http.request.orig_uri}.matches('^[^?]*(?:[.]|%2[Ee])(?:[.]|%2[Ee])'))`
	route {
		header Strict-Transport-Security "max-age=31536000; includeSubDomains"
		uri @break_glass_strip query -bl_break_glass
		request_body {
			max_size 1MiB
		}
		rate_limit {
			zone website_per_ip {
				key {http.request.remote.host}
				window 60s
				events 200
			}
		}
		rate_limit @members_magic_link {
			zone members_magic_link_per_ip {
				key {http.request.remote.host}
				window 60s
				events 5
			}
		}
		crowdsec
		appsec
		respond @ghost_setup 403
		reverse_proxy 10.20.1.100:8080
	}
}

