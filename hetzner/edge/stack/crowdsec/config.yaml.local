# Merged over the image's config.yaml by CrowdSec's own `.local` overlay, so the
# container still populates and owns config.yaml itself. Hand-maintained --
# nothing renders this file, unlike acquis.d/ beside it.
#
# Pinning the hub branch is what keeps a start independent of the CrowdSec hub.
# Unset, every `cscli` hub command fetches version.crowdsec.net first to choose
# a branch, and the entrypoint runs two unguarded `cscli parsers install` calls
# on every start under `set -e` -- so an unreachable hub crash-loops the
# container even when every item is already installed and current.
#
# `master` is the branch cscli picks while the pinned image is upstream's
# newest release. It goes stale when upstream ships a version NEWER than the
# image: from that moment an unpinned cscli would pick the `v<image-version>`
# branch, and this pin instead keeps pulling hub content built for an agent
# newer than the one running. The trigger is an upstream release, not any
# change in this repository, so nothing here detects it.
cscli:
  hub_branch: master

# The generated acquisition files are bind-mounted at /etc/crowdsec-acquis.d
# instead of the conventional /etc/crowdsec/acquis.d -- see the comment on
# that mount in compose.yml for why. This is what points CrowdSec back at
# them; acquisition_path is unset here and keeps config.yaml's default.
crowdsec_service:
  acquisition_dir: /etc/crowdsec-acquis.d
