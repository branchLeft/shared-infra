services:
  app:
    # The only place an image is named. The role refuses the file at its start
    # unless the reference ends in a sha256 digest.
    image: '{{ compose_stack_app_image }}'
    restart: unless-stopped
    env_file:
      - app.secret.env
    volumes:
      - ./app.conf:/etc/EXAMPLE_APP/app.conf:ro
      - app_data:/var/lib/EXAMPLE_APP
    healthcheck:
      test: ['CMD', 'EXAMPLE_HEALTH_COMMAND']
      interval: 30s
      timeout: 5s
      retries: 3
volumes:
  app_data: {}
