# The broker tunnel account (ghost-platform demo-host/provision/render_broker_tunnel.md).
# It may hold one -L forward, to the broker, and run nothing. Do not edit by hand.
Match User {{ demo1_build_tunnel_user }}
    AuthorizedKeysFile {{ demo1_build_tunnel_authorized_keys }}
    AuthenticationMethods publickey
    AllowTcpForwarding local
    PermitOpen {{ demo1_build_tunnel_broker_open }}
    PermitListen none
    GatewayPorts no
    AllowAgentForwarding no
    AllowStreamLocalForwarding no
    X11Forwarding no
    PermitTTY no
    PermitTunnel no
    PermitUserRC no
    ForceCommand {{ demo1_build_tunnel_nologin }}
# Ends the Match block, so lines after this drop-in are not read as part of it.
Match all
