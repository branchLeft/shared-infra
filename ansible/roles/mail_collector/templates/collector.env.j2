# Written by the mail_collector role while the collector is meant to run. Public values only, in
# the form docker reads (NAME=value, no quotes). The sending user and password, the drain token and
# the heartbeat URL are in the owner's credentials file, passed to the container beside this one.
COLLECTOR_DESCRIPTOR_DIR={{ mail_collector_container_descriptor_dir }}
COLLECTOR_DEDUPE_STATE_PATH={{ mail_collector_container_dedupe_file }}
COLLECTOR_PIN_STATE_DIR={{ mail_collector_container_pin_dir }}
COLLECTOR_SWEEGO_USAGE_STATE_PATH={{ mail_collector_container_sweego_usage_file }}
COLLECTOR_SMTP_HOST={{ mail_collector_smtp_host }}
{% if mail_collector_demo_mail_domain | length > 0 %}
COLLECTOR_DEMO_MAIL_DOMAIN={{ mail_collector_demo_mail_domain }}
{% endif %}
COLLECTOR_SMTP_PORT={{ mail_collector_smtp_port }}
COLLECTOR_SMTP_SECURE={{ mail_collector_smtp_secure | bool | lower }}
COLLECTOR_SHIM_SCHEME={{ mail_collector_shim_scheme }}
COLLECTOR_SHIM_PORT={{ mail_collector_shim_port }}
