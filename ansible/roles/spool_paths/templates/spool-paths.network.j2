# One address for each spool drain path, taken from the descriptor that names the host. Written by
# the spool_paths role.
[Match]
Name={{ spool_paths_interface }}

[Link]
RequiredForOnline=no

[Network]
ConfigureWithoutCarrier=yes
LinkLocalAddressing=no
IPv6AcceptRA=no
{% for path in spool_paths_plan_result.paths %}

[Address]
Address={{ path.alias }}/32
{% endfor %}
