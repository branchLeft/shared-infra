# Public values only, written by the ring_controller_host role. The names are an exact list.
# A key, a token or a path to an agent program has no place in this file. The record-signing key
# is not read from a path: the unit gives it to the controller under the name below, in the
# directory systemd names in CREDENTIALS_DIRECTORY.
RING_CONTROLLER_LEDGER_URL={{ ring_controller_host_ledger_url }}
RING_CONTROLLER_RECORD_SIGNING_KEY_NAME={{ ring_controller_host_record_key_id }}
RING_CONTROLLER_RECORD_PUBLIC_KEY_FILE={{ ring_controller_host_record_public_file }}
RING_CONTROLLER_STATE_DIR={{ ring_controller_host_state_dir }}
