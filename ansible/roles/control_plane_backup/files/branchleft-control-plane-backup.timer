[Unit]
Description=Nightly trigger for branchleft-control-plane-backup.service

[Timer]
# After the dump worker's 01:40 UTC run and before the state copy's 03:40 run, so the
# three never share the host's disk and network at once.
OnCalendar=*-*-* 02:40:00
RandomizedDelaySec=300
Persistent=true

[Install]
WantedBy=timers.target
