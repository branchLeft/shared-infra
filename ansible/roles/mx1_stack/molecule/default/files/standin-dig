#!/bin/sh
# TEST STAND-IN for dig, installed by prepare.yml ahead of the real one on PATH. The test
# instance has no resolver of its own to ask, and the answer must not depend on the network.
# It records each call, and answers an address, unless the switch dig_empty is set, which
# is a resolver that answers nothing.
state=/var/lib/standin-docker
printf '%s\n' "$*" >> "$state/dig.log"
if [ -e "$state/flags/dig_empty" ]; then
  exit 0
fi
echo 192.0.2.53
