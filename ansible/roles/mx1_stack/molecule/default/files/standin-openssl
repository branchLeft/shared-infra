#!/usr/bin/python3 -I
"""TEST STAND-IN for openssl s_client, installed by prepare.yml.

The instance runs no Caddy and no Stalwart to answer. It records each call, and prints the two
things the role's probe looks for (the server name and a verify code of 0), unless the switch
openssl_unverified is set.
"""

from __future__ import annotations

import os
import sys

STATE = "/var/lib/standin-docker"


def main(argv: list[str]) -> int:
    """Record the call and answer it."""
    try:
        with open(os.path.join(STATE, "openssl.log"), "a", encoding="utf-8") as handle:
            handle.write(" ".join(argv) + "\n")
    except OSError:
        pass
    if os.path.exists(os.path.join(STATE, "flags", "openssl_unverified")):
        print("Verify return code: 18 (self-signed certificate)")
    else:
        print("subject=CN = mx1.branchleft.co.uk")
        print("Verify return code: 0 (ok)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
