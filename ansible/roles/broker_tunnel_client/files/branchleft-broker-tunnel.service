# The broker tunnel: one ssh local forward, dialled from ops1, to the demo broker on
# demo1's loopback (127.0.0.1:8090), held at 127.0.0.1:18090 on ops1. ops1 initiates;
# the demo host never dials in. demo1's account for it may open that one port and
# nothing else, and runs no command.
#
# The unit starts only when the role's configuration, the pinned host key and the
# owner's private key are all there. A missing one leaves the unit inactive, not
# failed, so landing the role changes nothing until the owner has placed the key.
#
# ssh does the detecting and systemd does the restarting. While ssh is down nothing
# listens on 127.0.0.1:18090, so the broker's callers are refused at once and report
# the call as unanswered.
[Unit]
Description=Broker tunnel from ops1 to the demo broker on demo1
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/branchleft/broker-tunnel/demo1.conf
ConditionPathExists=/etc/branchleft/broker-tunnel/known_hosts
ConditionPathExists=/etc/branchleft/broker-tunnel/id_ed25519
StartLimitIntervalSec=0

[Service]
Type=exec
ExecStart=/usr/bin/ssh -F /etc/branchleft/broker-tunnel/demo1.conf -N demo1
Restart=always
RestartSec=5
RestartSteps=6
RestartMaxDelaySec=120
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=multi-user.target
