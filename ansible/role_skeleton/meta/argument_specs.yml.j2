---
argument_specs:
  main:
    short_description: Manage the EXAMPLE_FILES of {{ role_name }}
    description: Writes one configuration file from a template and one fixed notice file, or removes both.
    author: AUTHOR_NAME
    options:
      {{ role_name }}_state:
        type: str
        description: Whether the files are present or absent.
        choices: [present, absent]
        default: present
      {{ role_name }}_config_path:
        type: str
        description: Absolute path of the configuration file.
        default: /etc/{{ role_name }}.conf
      {{ role_name }}_notice_path:
        type: str
        description: Absolute path of the notice file.
        default: /etc/{{ role_name }}.notice
      {{ role_name }}_greeting:
        type: str
        description: Value written into the configuration file.
        default: EXAMPLE_GREETING
